<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      Host-side tests are a SEPARATE toolchain from the phone app, as required
      by the mission brief. LangVersion is pinned to 5 so that anything that
      compiles here is also valid for the VS2013 C# 5 compiler used for the
      Windows Phone 8.1 build. This project must never be referenced by the
      phone .csproj.
    -->
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>KdeConnectCore.HostTests</AssemblyName>
    <RootNamespace>KdeConnect.HostTests</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\KDEConnect.WP81\Core\**\*.cs" />
    <Compile Include="..\KDEConnect.WP81\Transport\TlsContracts.cs" />
    <Compile Include="..\KDEConnect.WP81\Security\**\*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Same Bouncy Castle version the phone project vendors as a binary
      (lib/BouncyCastle.Crypto.dll, PCL Profile328). The netstandard2.0 build
      of the identical 1.8.2 release is used here so the API surface exercised
      by these tests is the one the phone will load.
    -->
    <PackageReference Include="Portable.BouncyCastle" Version="1.8.2" />
  </ItemGroup>

</Project>
