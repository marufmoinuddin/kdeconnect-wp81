<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest" xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest" xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="9e1c61c5-0950-459c-b7fe-4f4559a7a62b" Publisher="CN=Maruf" Version="1.0.1.0" />
  <mp:PhoneIdentity PhoneProductId="9e1c61c5-0950-459c-b7fe-4f4559a7a62b" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>KDE Connect</DisplayName>
    <PublisherDisplayName>Maruf</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="KDEConnect.WP81.App">
      <m3:VisualElements DisplayName="KDE Connect" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\SmallLogo.png" Description="KDE Connect client for Windows Phone 8.1 - pair with KDE Connect desktops over the local network." ForegroundText="light" BackgroundColor="transparent">
        <m3:DefaultTile Wide310x150Logo="Assets\WideLogo.png" Square71x71Logo="Assets\Square71x71Logo.png">
        </m3:DefaultTile>
        <m3:SplashScreen Image="Assets\SplashScreen.png" />
      </m3:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!--
      internetClientServer is the capability Microsoft's UDP/socket how-tos tell
      you to select for a Windows Phone build, and on phone it already grants
      full local and Internet access, client and server. privateNetworkClientServer
      is documented as equivalent there; it is declared as well because LAN
      reachability is the one thing this app cannot gamble on, and declaring both
      is harmless.
    -->
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />

    <!--
      removableStorage is what makes the SD card visible. Third-party file
      managers on this platform all declare it; without it KnownFolders.
      RemovableDevices throws UnauthorizedAccessException and the card simply
      does not appear, which reads like a platform limitation when it is a
      missing declaration.
    -->
    <Capability Name="removableStorage" />
  </Capabilities>
</Package>