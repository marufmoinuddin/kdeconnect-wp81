<Page
    x:Class="KDEConnect.WP81.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KDEConnect.WP81"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,8">
            <TextBlock Text="About" FontSize="22" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,12">
            <StackPanel>
                <Border Background="#1FFFFFFF" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="KDE Connect for Windows Phone 8.1" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Version 1.0.0" Margin="0,4,0,0" Opacity="0.7" FontSize="18" />
                        <TextBlock Text="A KDE Connect client for Windows Phone 8.1 implementing the KDE Connect wire protocol with mutual TLS." Margin="0,12,0,0" TextWrapping="Wrap" FontSize="15" />
                    </StackPanel>
                </Border>

                <Border Background="#1FFFFFFF" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Protocol" FontSize="18" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Protocol Version:" Width="180" VerticalAlignment="Center"/>
                            <TextBlock Text="8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Discovery:" Width="180" VerticalAlignment="Center"/>
                            <TextBlock Text="UDP 1716" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="TCP Range:" Width="180" VerticalAlignment="Center"/>
                            <TextBlock Text="1716-1764" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="TLS:" Width="180" VerticalAlignment="Center"/>
                            <TextBlock Text="Mutual TLS with cert pinning (Bouncy Castle 1.8.2)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1FFFFFFF" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Platform Limits" FontSize="18" />
                        <TextBlock Text="• No background execution (app suspends on lock)" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" FontSize="15" />
                        <TextBlock Text="• No clipboard API (outgoing text only)" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" FontSize="15" />
                        <TextBlock Text="• No notifications/SMS/telephony access" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" FontSize="15" />
                        <TextBlock Text="• File picker requires PickSingleFileAndContinue()" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" FontSize="15" />
                        <TextBlock Text="• UDP broadcast send behavior is undocumented/unreliable" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" FontSize="15" />
                    </StackPanel>
                </Border>

                <Border Background="#1FFFFFFF" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Third Party" FontSize="18" />
                        <TextBlock Text="Bouncy Castle Crypto 1.8.2 (MIT/X11 license)" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="15" />
                        <TextBlock Text="See THIRD-PARTY-NOTICE.md for full attribution." Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="15" />
                    </StackPanel>
                </Border>

                <Border Background="#1FFFFFFF" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Source" FontSize="18" />
                        <TextBlock Text="https://github.com/marufmoinuddin/kdeconnect-wp81" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="15" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>