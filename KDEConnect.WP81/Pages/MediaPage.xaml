<Page
    x:Class="KDEConnect.WP81.Pages.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,8">
            <TextBlock Text="Media" Style="{ThemeResource SubheaderTextBlockStyle}"/>
            <TextBlock x:Name="PlayerText" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,12">
            <StackPanel>
                <Border Background="{ThemeResource AppBarBackgroundThemeBrush}" Padding="12" CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="(no media)" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ArtistText" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="PositionText" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="&#xE100;" FontFamily="Segoe UI Symbol" FontSize="24" Width="72" Click="OnPrevious" Margin="0,0,8,0"/>
                    <Button x:Name="PlayPauseButton" Content="&#xE102;" FontFamily="Segoe UI Symbol" FontSize="28" Width="88" Click="OnPlayPause" Margin="0,0,8,0"/>
                    <Button Content="&#xE101;" FontFamily="Segoe UI Symbol" FontSize="24" Width="72" Click="OnNext"/>
                </StackPanel>

                <TextBlock Text="Player volume" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,20,0,4" Opacity="0.7"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="1"
                        ValueChanged="OnVolumeChanged"/>
                <TextBlock x:Name="VolumeText" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"/>

                <Button Content="Refresh" Click="OnRefresh" Margin="0,16,0,0"/>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
