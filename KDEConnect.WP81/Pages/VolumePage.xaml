<Page
    x:Class="KDEConnect.WP81.Pages.VolumePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,8">
            <TextBlock Text="Desktop volume" FontSize="18" />
            <TextBlock Text="Audio outputs reported by the desktop" Opacity="0.7" FontSize="12" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel x:Name="SinkPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="12,0,12,12">
            <Button Content="Refresh sinks" Click="OnRefresh" HorizontalAlignment="Stretch"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </Grid>
</Page>
