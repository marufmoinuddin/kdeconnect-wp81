<Page
    x:Class="KDEConnect.WP81.Pages.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      Deliberately plain.

      The previous template bound Visibility through a value converter and a
      Brush through a computed property. Each of those is a way for a page to
      fail at runtime in a manner no compiler sees, and this is the page where
      the app has been dying. Now: two TextBlocks, two string bindings, no
      converter, no brush, no theme style.
    -->
    <Page.Resources>
        <DataTemplate x:Key="DeviceItemTemplate">
            <Grid Margin="12,10" Tapped="OnDeviceTapped" Tag="{Binding DeviceId}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding DisplayName}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding Subtitle}"
                           FontSize="12"
                           Opacity="0.7"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,10,12,0">
            <TextBlock Text="KDE Connect" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="OwnDeviceName" Text="starting" FontSize="12" Opacity="0.7"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ListView x:Name="DeviceListView"
                      ItemTemplate="{StaticResource DeviceItemTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="24">
                <TextBlock Text="No devices yet" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Tap Refresh to announce this phone, or use Add by IP."
                           FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <ProgressRing x:Name="RefreshRing" Width="40" Height="40"
                          VerticalAlignment="Top" HorizontalAlignment="Center"
                          Margin="0,20,0,0" IsActive="False"/>
        </Grid>


    </Grid>

    <!-- Attached property of the root Page: must be a direct child of <Page>. -->
        <Page.BottomAppBar>
            <CommandBar ClosedDisplayMode="Minimal">
                <CommandBar.PrimaryCommands>
                    <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="OnRefreshClick"/>
                    <AppBarButton x:Name="AddDeviceButton" Icon="Add" Label="Add by IP" Click="OnAddDeviceClick"/>
                    <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Settings" Click="OnSettingsClick"/>
                </CommandBar.PrimaryCommands>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="Help" Label="About" Click="OnAboutClick"/>
                    <AppBarButton Icon="Document" Label="Diagnostics" Click="OnDiagnosticsClick"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Page.BottomAppBar>
</Page>
