<Page
    x:Class="KDEConnect.WP81.Pages.DeviceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KDEConnect.WP81"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="DeviceItemTemplate">
            <Grid Margin="12,8" Tapped="OnDeviceTapped" Tag="{Binding DeviceId}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Device icon -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    Text="&#xE133;" FontFamily="Segoe UI Symbol" FontSize="32"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    Foreground="{ThemeResource PhoneAccentBrush}"/>

                <!-- Device name and ID -->
                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource ListViewItemTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DeviceId}" Style="{ThemeResource ListViewItemContentTextBlockStyle}" FontSize="11" Opacity="0.6"/>
                </StackPanel>

                <!-- Status badge -->
                <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                    Background="{Binding StatusColor}" Padding="8,4" CornerRadius="4"
                    VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <!-- Capability badges row -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <Border Background="{ThemeResource PhoneAccentBrush}" Padding="4,1" CornerRadius="2" Margin="0,0,4,0" Visibility="{Binding HasPing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Ping" FontSize="9" Foreground="White"/>
                    </Border>
                    <Border Background="{ThemeResource PhoneAccentBrush}" Padding="4,1" CornerRadius="2" Margin="0,0,4,0" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Battery" FontSize="9" Foreground="White"/>
                    </Border>
                    <Border Background="{ThemeResource PhoneAccentBrush}" Padding="4,1" CornerRadius="2" Margin="0,0,4,0" Visibility="{Binding HasFileTransfer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Files" FontSize="9" Foreground="White"/>
                    </Border>
                    <Border Background="{ThemeResource PhoneAccentBrush}" Padding="4,1" CornerRadius="2" Margin="0,0,4,0" Visibility="{Binding HasMpris, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Media" FontSize="9" Foreground="White"/>
                    </Border>
                    <Border Background="{ThemeResource PhoneAccentBrush}" Padding="4,1" CornerRadius="2" Margin="0,0,4,0" Visibility="{Binding HasMousepad, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Mouse" FontSize="9" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="&#xE133;" FontFamily="Segoe UI Symbol" FontSize="72" Foreground="{ThemeResource PhoneAccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No devices found" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                <TextBlock Text="Pull to refresh or tap + to add a device by IP" Style="{ThemeResource BodyTextBlockStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" Opacity="0.7"/>
            </StackPanel>
        </DataTemplate>

        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8">
            <TextBlock Text="KDE Connect" Style="{ThemeResource HeaderTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Text=":" Style="{ThemeResource HeaderTextBlockStyle}" VerticalAlignment="Center" Opacity="0.5" Margin="0,0,8,0"/>
            <TextBlock x:Name="OwnDeviceName" Text="WP81" Style="{ThemeResource SubheaderTextBlockStyle}" VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <!-- Device list -->
        <Grid Grid.Row="1">
            <ListView x:Name="DeviceListView"
                ItemsSource="{Binding}"
                ItemTemplate="{StaticResource DeviceItemTemplate}"
                IsItemClickEnabled="False"
                SelectionMode="None"
                ShowsScrollingPlaceholders="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <ContentControl x:Name="EmptyState" ContentTemplate="{StaticResource EmptyStateTemplate}" Visibility="Collapsed"/>
        </Grid>

        <!-- Pull-to-refresh indicator -->
        <ProgressRing x:Name="RefreshRing" Grid.Row="1" Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" IsActive="False"/>

        <!-- App bar -->
        <Page.BottomAppBar>
            <CommandBar ClosedDisplayMode="Minimal" Background="{ThemeResource AppBarBackgroundThemeBrush}">
                <CommandBar.PrimaryCommands>
                    <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="Refresh" Click="OnRefreshClick"/>
                    <AppBarButton x:Name="AddDeviceButton" Icon="Add" Label="Add by IP" Click="OnAddDeviceClick"/>
                    <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Settings" Click="OnSettingsClick"/>
                </CommandBar.PrimaryCommands>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="Help" Label="About" Click="OnAboutClick"/>
                    <AppBarButton Icon="Document" Label="Diagnostics" Click="OnDiagnosticsClick"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Page.BottomAppBar>
    </Grid>
</Page>