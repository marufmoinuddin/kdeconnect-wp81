<Page
    x:Class="KDEConnect.WP81.Pages.MousepadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,8,12,0">
            <TextBlock x:Name="HeaderText" Text="Touchpad" FontSize="18" />
        </StackPanel>

        <!-- Drag anywhere here to move the pointer. -->
        <Border Grid.Row="1" Margin="12" Background="#1FFFFFFF"
                CornerRadius="8" ManipulationMode="All"
                ManipulationDelta="OnPadManipulationDelta"
                DoubleTapped="OnPadDoubleTapped"
                Tapped="OnPadTapped">
            <TextBlock Text="drag to move the pointer"
                       Opacity="0.5" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="16" FontSize="15" />
        </Border>

        <StackPanel Grid.Row="2" Margin="12,0,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Left" Click="OnLeftClick" Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" Content="Right" Click="OnRightClick" Margin="4,0,4,0" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="2" Content="Middle" Click="OnMiddleClick" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Scroll up" Click="OnScrollUp" Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" Content="Scroll down" Click="OnScrollDown" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
            </Grid>

            <TextBox x:Name="KeyBox" Margin="0,8,0,0" PlaceholderText="Type here to send keys"
                     AcceptsReturn="False" KeyUp="OnKeyUp"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Enter" Click="OnEnterKey" Margin="0,0,4,0"/>
                <Button Content="Backspace" Click="OnBackspaceKey" Margin="0,0,4,0"/>
                <Button Content="Esc" Click="OnEscapeKey" Margin="0,0,4,0"/>
                <Button Content="Tab" Click="OnTabKey"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Opacity="0.7" FontSize="12" />
        </StackPanel>
    </Grid>
</Page>
